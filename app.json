{
  "expo": {
    "name": "toNikah",
    "slug": "tonikah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon/icon.png",
    "scheme": "tonikah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tonikah.app",
      "infoPlist": {
        "CFBundleAllowMixedLocalizations": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.349696991792-vkr3uaifi2i7ot8v39bjh79sf304f90f"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.tonikah.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow toNikah to use your location to fill your current city."
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow toNikah to access your photos so you can add profile gallery images."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon/adaptive-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "locales": {
      "en": "./locales/en.json",
      "ar": "./locales/ar.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "id": "./locales/id.json",
      "it": "./locales/it.json",
      "pl": "./locales/pl.json",
      "pt": "./locales/pt.json",
      "ru": "./locales/ru.json",
      "tr": "./locales/tr.json"
    },
    "extra": {
      "APP_ENV": "dev",
      "router": {},
      "eas": {
        "projectId": "731d412f-a6af-4208-a2e3-78da74e0ea97"
      }
    }
  }
}
